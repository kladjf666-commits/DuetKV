+        report["rows"].append(row)
+        support.write_json(a.output, report)
+        print(json.dumps(row["shape"]), flush=True)
+    report["status"] = "cpu_storage_only" if a.cpu_audit else "profile_only" if a.profile else "measured"
+    support.write_json(a.output, report)
+
+
